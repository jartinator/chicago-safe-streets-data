{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jartinator.github.io/chicago-safe-streets-data/api/v1/schemas/divvy.schema.json",
  "title": "divvy.json — per-ward Divvy trip-volume proxy",
  "description": "See build_divvy_api() in pipeline/emit_api.py. Trip counts are a station-placement-biased proxy for cycling volume, published as context beside crash counts — never a denominator for a risk rate. `exposure` is absent when status is no_data_yet.",
  "type": "object",
  "properties": {
    "_meta": { "$ref": "envelope.schema.json" },
    "status": { "type": "string", "enum": ["ok", "no_data_yet"] },
    "note": { "type": "string" },
    "exposure": {
      "type": "object",
      "properties": {
        "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "source_key": { "type": "string" },
        "wards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ward": { "type": "string" },
              "trip_count": { "type": "integer", "minimum": 0 }
            },
            "required": ["ward", "trip_count"],
            "additionalProperties": false
          }
        },
        "data_tier": { "type": "string", "enum": ["proxy"] },
        "caveat_tags": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "caveat": { "type": "string" }
      },
      "required": ["as_of", "source_key", "wards", "data_tier", "caveat_tags", "caveat"],
      "additionalProperties": false
    }
  },
  "required": ["_meta", "status", "note"],
  "additionalProperties": false
}
